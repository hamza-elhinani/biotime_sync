<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="biotime_sync.Dashboard">
        <div class="o_action biotime_dashboard">
            <div class="container-fluid p-4">
                <!-- Loading State -->
                <div t-if="state.loading" class="text-center p-5">
                    <i class="fa fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3 text-muted">Chargement du tableau de bord...</p>
                </div>
                
                <!-- Error State -->
                <div t-if="state.error" class="alert alert-danger m-3">
                    <i class="fa fa-exclamation-triangle me-2"></i>
                    <t t-esc="state.error"/>
                </div>
                
                <!-- Dashboard Content -->
                <div t-if="!state.loading and !state.error">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="mb-1">
                                <i class="fa fa-dashboard me-2 text-primary"></i>
                                Tableau de Bord Biotime
                            </h2>
                            <small class="text-muted" t-if="state.lastSyncDate">
                                Dernière sync: <t t-esc="formatDate(state.lastSyncDate)"/> 
                                <span t-attf-class="badge ms-1 #{state.lastSyncStatus === 'success' ? 'bg-success' : state.lastSyncStatus === 'error' ? 'bg-danger' : 'bg-warning'}">
                                    <t t-esc="state.lastSyncStatus"/>
                                </span>
                            </small>
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-outline-primary" t-on-click="onRefresh">
                                <i class="fa fa-refresh me-1"></i> Actualiser
                            </button>
                            <button class="btn btn-outline-success" t-on-click="onSyncToHR">
                                <i class="fa fa-exchange me-1"></i> Sync vers Présences
                            </button>
                        </div>
                    </div>
                    
                    <!-- Stats Cards Row 1 -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <div class="display-4 text-primary mb-2">
                                        <t t-esc="state.stats.total_employees"/>
                                    </div>
                                    <h6 class="text-muted mb-0">
                                        <i class="fa fa-users me-1"></i> Total Employés
                                    </h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm h-100 bg-success bg-opacity-10">
                                <div class="card-body text-center">
                                    <div class="display-4 text-success mb-2">
                                        <t t-esc="state.stats.present_count"/>
                                    </div>
                                    <h6 class="text-muted mb-0">
                                        <i class="fa fa-check-circle me-1"></i> Présents Aujourd'hui
                                    </h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm h-100 bg-warning bg-opacity-10">
                                <div class="card-body text-center">
                                    <div class="display-4 text-warning mb-2">
                                        <t t-esc="state.stats.late_count"/>
                                    </div>
                                    <h6 class="text-muted mb-0">
                                        <i class="fa fa-clock-o me-1"></i> En Retard
                                    </h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm h-100 bg-danger bg-opacity-10">
                                <div class="card-body text-center">
                                    <div class="display-4 text-danger mb-2">
                                        <t t-esc="state.stats.absent_count"/>
                                    </div>
                                    <h6 class="text-muted mb-0">
                                        <i class="fa fa-times-circle me-1"></i> Absents
                                    </h6>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Stats Cards Row 2 -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h6 class="text-muted mb-3">
                                        <i class="fa fa-pie-chart me-1"></i> Taux de Présence
                                    </h6>
                                    <div class="progress" style="height: 25px;">
                                        <div class="progress-bar bg-success" 
                                             role="progressbar" 
                                             t-att-style="'width: ' + presenceRate + '%'">
                                            <t t-esc="presenceRate"/>%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h6 class="text-muted mb-3">
                                        <i class="fa fa-clock-o me-1"></i> Heures Travaillées (Aujourd'hui)
                                    </h6>
                                    <div class="display-5 text-primary">
                                        <t t-esc="state.stats.total_worked_hours"/> h
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h6 class="text-muted mb-3">
                                        <i class="fa fa-exchange me-1"></i> Synchronisation HR
                                    </h6>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge bg-success me-2">
                                                <t t-esc="state.stats.synced_count"/> synced
                                            </span>
                                            <span class="badge bg-warning cursor-pointer" t-on-click="onViewNotSynced" style="cursor: pointer;">
                                                <t t-esc="state.stats.not_synced_count"/> pending
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted"><t t-esc="syncRate"/>%</small>
                                        </div>
                                    </div>
                                    <div class="progress mt-2" style="height: 8px;">
                                        <div class="progress-bar bg-success" 
                                             role="progressbar" 
                                             t-att-style="'width: ' + syncRate + '%'">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tables Row -->
                    <div class="row g-3">
                        <!-- Recent Attendance -->
                        <div class="col-md-8">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <i class="fa fa-list me-2"></i> Présences Récentes
                                    </h5>
                                    <button class="btn btn-sm btn-outline-primary" t-on-click="onViewAttendance">
                                        Voir tout
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Employé</th>
                                                <th>Date</th>
                                                <th>Entrée</th>
                                                <th>Sortie</th>
                                                <th>Heures</th>
                                                <th>Statut</th>
                                                <th>Sync</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.recentAttendance" t-as="att" t-key="att.id">
                                                <tr>
                                                    <td><t t-esc="att.employee_id[1]"/></td>
                                                    <td><t t-esc="formatDate(att.date)"/></td>
                                                    <td><t t-esc="formatTime(att.check_in)"/></td>
                                                    <td><t t-esc="formatTime(att.check_out)"/></td>
                                                    <td><t t-esc="formatHours(att.worked_hours)"/></td>
                                                    <td>
                                                        <span t-attf-class="badge #{getStatusClass(att.status)}">
                                                            <t t-esc="getStatusLabel(att.status)"/>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <i t-if="att.synced_to_hr" class="fa fa-check text-success"></i>
                                                        <i t-else="" class="fa fa-clock-o text-warning"></i>
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr t-if="!state.recentAttendance.length">
                                                <td colspan="7" class="text-center text-muted py-4">
                                                    Aucune présence enregistrée
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Top Late Employees -->
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-exclamation-triangle text-warning me-2"></i> 
                                        Top Retards (7 jours)
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <ul class="list-group list-group-flush">
                                        <t t-foreach="state.topLate" t-as="emp" t-key="emp.name">
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                <div>
                                                    <i class="fa fa-user me-2 text-muted"></i>
                                                    <t t-esc="emp.name"/>
                                                </div>
                                                <div>
                                                    <span class="badge bg-warning me-1">
                                                        <t t-esc="emp.count"/> fois
                                                    </span>
                                                    <small class="text-muted">
                                                        (<t t-esc="emp.totalMinutes"/> min)
                                                    </small>
                                                </div>
                                            </li>
                                        </t>
                                        <li t-if="!state.topLate.length" class="list-group-item text-center text-muted py-4">
                                            Aucun retard cette semaine
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            
                            <!-- Quick Actions -->
                            <div class="card border-0 shadow-sm mt-3">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-bolt me-2"></i> Actions Rapides
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-outline-primary" t-on-click="onSyncEmployees">
                                            <i class="fa fa-users me-2"></i> Sync Employés
                                        </button>
                                        <button class="btn btn-outline-success" t-on-click="onSyncToHR">
                                            <i class="fa fa-exchange me-2"></i> Sync vers HR Attendance
                                        </button>
                                        <button class="btn btn-outline-info" t-on-click="onViewHRAttendance">
                                            <i class="fa fa-calendar-check-o me-2"></i> Voir Présences Odoo
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
