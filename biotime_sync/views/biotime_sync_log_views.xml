<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Biotime Sync Log List View -->
    <record id="view_biotime_sync_log_tree" model="ir.ui.view">
        <field name="name">biotime.sync.log.list</field>
        <field name="model">biotime.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs">
                <field name="sync_date"/>
                <field name="sync_type"/>
                <field name="records_created"/>
                <field name="records_updated"/>
                <field name="records_skipped"/>
                <field name="status"/>
                <field name="duration" widget="float_time"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- Biotime Sync Log Form View -->
    <record id="view_biotime_sync_log_form" model="ir.ui.view">
        <field name="name">biotime.sync.log.form</field>
        <field name="model">biotime.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Sync Information">
                            <field name="sync_date"/>
                            <field name="sync_type"/>
                            <field name="status"/>
                            <field name="duration" widget="float_time"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Results">
                            <field name="records_created"/>
                            <field name="records_updated"/>
                            <field name="records_skipped"/>
                        </group>
                    </group>
                    <group string="Error Details" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Biotime Sync Log Search View -->
    <record id="view_biotime_sync_log_search" model="ir.ui.view">
        <field name="name">biotime.sync.log.search</field>
        <field name="model">biotime.sync.log</field>
        <field name="arch" type="xml">
            <search string="Search Sync Logs">
                <field name="sync_date"/>
                <field name="sync_type"/>
                <field name="status"/>
                <field name="user_id"/>
                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Error" name="error" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter string="Type" name="group_type" context="{'group_by': 'sync_type'}"/>
                <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <!-- Biotime Sync Log Action -->
    <record id="action_biotime_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">biotime.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_biotime_sync_log_search"/>
    </record>
</odoo>
