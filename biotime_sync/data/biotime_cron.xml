<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Scheduled Action: Hourly Attendance Sync -->
        <record id="ir_cron_biotime_attendance_sync" model="ir.cron">
            <field name="name">Biotime: Hourly Attendance Sync</field>
            <field name="model_id" ref="model_biotime_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_attendance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
        
    </data>
</odoo>
